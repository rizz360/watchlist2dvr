{
  "name": "watchlist2dvr",
  "version": "0.4.0",
  "description": "Synchronizes a movie watchlist with a DVR backend via EPG matching",
  "private": true,
  "type": "module",
  "main": "dist/scheduler.js",
  "scripts": {
    "build": "tsc",
    "dev": "tsx watch src/scheduler.ts",
    "start": "node dist/scheduler.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src --ext .ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "axios": "^1.7.9",
    "express": "^5.2.1",
    "fuse.js": "^7.1.0",
    "got-scraping": "^4.2.1",
    "ioredis": "^5.4.1",
    "js-yaml": "^4.1.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.10.5",
    "@typescript-eslint/eslint-plugin": "^8.18.2",
    "@typescript-eslint/parser": "^8.18.2",
    "eslint": "^9.17.0",
    "globals": "^17.3.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^2.1.8"
  }
}
