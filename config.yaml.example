sources:
  - type: trakt
    client_id: "YOUR_TRAKT_CLIENT_ID"
    client_secret: "YOUR_TRAKT_CLIENT_SECRET"
    username: "YOUR_TRAKT_USERNAME"

  # --- IMDb Public Lists ---
  # Fetch any number of public IMDb URLs per run — no authentication required.
  # Supported: charts (Top 250, Popular, MovieMeter) and public user lists.
  #
  # - type: imdb_public_lists
  #   lists:
  #     - https://www.imdb.com/chart/top/        # IMDb Top 250
  #     - https://www.imdb.com/chart/popular/    # Most popular right now
  #     - https://www.imdb.com/list/ls000024621/ # Any public user list

  # --- IMDb Auto-download ---
  # Directly downloads your IMDb watchlist and/or ratings as CSV using a
  # session cookie — no browser automation or Python required.
  #
  # How to get your cookie (takes ~1 minute):
  #   1. Go to https://www.imdb.com and sign in
  #   2. Open DevTools: F12 (Windows/Linux) or Cmd+Option+I (Mac)
  #   3. Application tab → Storage → Cookies → https://www.imdb.com
  #   4. Find "at-main" → copy its Value (a long URL-encoded string)
  #
  # Your user ID is the "urXXXXXXX" part of your IMDb profile URL:
  #   https://www.imdb.com/user/ur12345678/
  #
  # The cookie expires when you log out. If fetching breaks, re-copy it
  # from DevTools and restart the service. The Sources tab in the web UI
  # shows the last fetch status and lets you trigger a manual refresh.
  #
  # - type: imdb_auto
  #   user_id: "ur12345678"
  #   cookie: "YOUR_AT_MAIN_COOKIE_VALUE"
  #   lists:
  #     - watchlist    # movies you've marked "Want to See"
  #     - ratings      # movies you've rated on IMDb
  #   min_rating: 1   # for ratings: skip movies rated below this (1–10)
  #   poll_timeout_seconds: 120   # optional: max wait for IMDb export (default: 120)
  #   poll_interval_seconds: 4    # optional: polling cadence in seconds (default: 4)

  # --- IMDb CSV (manual export) ---
  # Drop any IMDb export CSV (watchlist, ratings, etc.) into the directory —
  # type is auto-detected by headers.
  # - type: imdb_csv
  #   path: /data             # directory or single file
  #   min_rating: 7           # for ratings CSVs: skip movies rated below this (1–10, default: 1)

library:
  - type: jellyfin
    url: http://jellyfin:8096
    api_key: "YOUR_JELLYFIN_API_KEY"

  # - type: plex
  #   url: http://plex:32400
  #   token: "YOUR_PLEX_TOKEN"

  # Remove the library section entirely to disable library checks.

tmdb:
  api_key: "YOUR_TMDB_API_KEY"

matching:
  preferred_language: de
  fallback_languages:
    - en
  strict_year_match: false
  year_tolerance: 1
  fuzzy_enabled: false
  fuzzy_threshold: 0.85

dvr:
  type: tvheadend
  url: http://tvheadend:9981
  username: ""
  password: ""

state:
  redis_url: redis://redis:6379

scheduler:
  mode: polling          # polling | oneshot
  interval_minutes: 60
  dry_run: false         # true = log matches but do not write to DVR

web:
  enabled: true
  port: 3000
